# Optional: omit this to use the local SQLite database automatically.
MONGODB_URI
MONGODB_DATABASE
# Same Mongoose collection name as src/models/resumeInfo.ts.
MONGODB_COLLECTION
MONGODB_KB_COLLECTION
MONGODB_VECTOR_INDEX

# Optional enrichment only; importing does not depend on Gemini.
GEMINI_API_KEY
GEMINI_MODEL
GEMINI_EMBEDDING_MODEL
GEMINI_EMBEDDING_DIMENSIONS

# Backup AI provider. Create a free OpenRouter key and leave the model as the
# free router unless you later choose a paid, pinned production model.
OPENROUTER_API_KEY
OPENROUTER_MODEL
OPENROUTER_BASE_URL
AI_FALLBACK_ENABLED

MAX_UPLOAD_MB
MIN_CONFIDENCE
REVIEW_CONFIDENCE
DATABASE_MODE
LOCAL_DATABASE_PATH
